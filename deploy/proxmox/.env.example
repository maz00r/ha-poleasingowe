# Obraz aplikacji jest wersjonowany. Nie używaj `latest` w produkcji.
POLEASINGOWE_VERSION=0.30.0

# Statyczny prywatny adres VM widoczny dla osobnej VM/LXC z cloudflared.
APP_BIND_IP=192.168.1.50

# Trwałe katalogi hosta. Utwórz je przed pierwszym startem zgodnie z README.
POSTGRES_DATA_DIR=/srv/poleasingowe/postgres
APP_DATA_DIR=/srv/poleasingowe/data
APP_SHARE_DIR=/srv/poleasingowe/share
OPTIONS_FILE=/etc/poleasingowe/options.json

# Każdy plik zawiera wyłącznie hasło i końcowy znak nowej linii.
POSTGRES_ADMIN_PASSWORD_FILE=/etc/poleasingowe/secrets/postgres_admin_password
POLEASINGOWE_APP_PASSWORD_FILE=/etc/poleasingowe/secrets/poleasingowe_app_password
GRAFANA_RO_PASSWORD_FILE=/etc/poleasingowe/secrets/grafana_ro_password
